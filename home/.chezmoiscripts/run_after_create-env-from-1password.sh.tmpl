#!/usr/bin/env bash
#
# Create ~/.env from 1Password once.
#
# Routine chezmoi applies must not call `op`: headless sessions should be able
# to apply dotfiles without opening a GUI unlock prompt. Delete ~/.env and run
# `chezmoi apply` while 1Password is unlocked to regenerate it.

set -euo pipefail

ENV_FILE="$HOME/.env"

if [[ -f "$ENV_FILE" ]]; then
    exit 0
fi

if ! command -v op >/dev/null 2>&1; then
    printf '1Password CLI (op) not found; skipping %s creation.\n' "$ENV_FILE" >&2
    exit 0
fi

if [[ ! -t 0 ]]; then
    printf '%s is missing, but this is a non-interactive session; skipping 1Password read.\n' "$ENV_FILE" >&2
    exit 0
fi

# No 1Password account configured (headless/public box): skip instead of
# letting `op read` drop into its interactive "add an account?" prompt and then
# fail under set -e. Delete ~/.env and re-apply once an account is signed in to
# regenerate.
if ! op account list 2>/dev/null | grep -q .; then
    printf 'No 1Password account configured; skipping %s creation.\n' "$ENV_FILE" >&2
    exit 0
fi

tmp="$(mktemp "${ENV_FILE}.XXXXXX")"
cleanup() {
    rm -f "$tmp"
}
trap cleanup EXIT

shell_quote() {
    printf "'"
    printf "%s" "$1" | sed "s/'/'\\\\''/g"
    printf "'"
}

write_export() {
    local name="$1"
    local op_ref="$2"
    local value

    value="$(op read --no-newline "$op_ref")"
    printf 'export %s=' "$name" >> "$tmp"
    shell_quote "$value" >> "$tmp"
    printf '\n' >> "$tmp"
}

chmod 600 "$tmp"
{
    printf '# Generated by chezmoi from 1Password.\n'
    printf '# Delete this file and run `chezmoi apply` to regenerate it.\n\n'
} > "$tmp"

write_export ANTHROPIC_API_KEY "op://Personal/Anthropic/API Key"
write_export OPENAI_API_KEY "op://Personal/OpenAI/API Key"
write_export LINEAR_API_KEY "op://Personal/Linear/API Key"
write_export OPENROUTER_API_KEY "op://Personal/OpenRouter/API Key"
write_export FORGEJO_API_KEY "op://Personal/Forgejo/API Key"
write_export READWISE_API_KEY "op://Personal/Readwise/API Key"
{{ if .work -}}
write_export CURSOR_API_KEY "op://Empyrean/Cursor/API Key"
{{ else -}}
write_export CURSOR_API_KEY "op://Personal/Cursor/API Key"
{{- end }}

mv "$tmp" "$ENV_FILE"
trap - EXIT
printf 'Created %s from 1Password.\n' "$ENV_FILE"
