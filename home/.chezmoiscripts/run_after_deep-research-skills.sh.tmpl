{{ if .workstation -}}
#!/usr/bin/env bash
{{/*
    Install the Deep Research skill pack (namespaced dr-*) for Claude Code and
    Codex. The pack needs renamed skills and an agent with a companion module
    directory, neither of which the flat mirror (run_after_symlink-ai-mirror)
    can project, so it is installed out-of-band by agent-tooling's own script.
    The dr-* skills land as real directories and coexist with the mirror
    (which only prunes dead symlinks). Fast-path exits without network once the
    pack is already in place.
*/}}
set -euo pipefail

INSTALLER="$HOME/.agent-tooling/scripts/install-deep-research.sh"

# agent-tooling external not cloned yet (fresh machine, first apply): skip; the
# next `chezmoi apply` runs once the external is present.
[[ -x "$INSTALLER" ]] || exit 0

sentinels=(
    "$HOME/.claude/skills/dr-research/SKILL.md"
    "$HOME/.claude/skills/dr-research-report/SKILL.md"
    "$HOME/.claude/agents/web-search-agent.md"
    "$HOME/.claude/agents/web-search-modules/general-web.md"
    "$HOME/.codex/skills/dr-research/SKILL.md"
    "$HOME/.codex/agents/web-researcher.toml"
)

installed=1
for s in "${sentinels[@]}"; do
    [[ -e "$s" ]] || installed=0
done
if [[ "$installed" -eq 1 ]] && python3 -c 'import yaml' >/dev/null 2>&1; then
    exit 0
fi

echo "Deep Research skills: installing via $INSTALLER"
if ! bash "$INSTALLER"; then
    echo "WARNING: deep-research install failed; run 'just install-deep-research' in ~/.agent-tooling" >&2
fi
exit 0
{{ end -}}
