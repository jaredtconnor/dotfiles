{{- $d := joinPath .chezmoi.homeDir ".dotfiles-private" "ssh" -}}
{{- if and (eq .chezmoi.os "windows") (stat $d) -}}
# Windows counterpart to place-private-ssh-pubs.sh. Places public-key hints from
# the private companion into ~/.ssh. These are only hints so the 1Password agent
# offers the right key (avoids the six-key limit); no private key material is
# involved. Generic glob, no identities named here.
$ErrorActionPreference = "Stop"
$src = Join-Path $env:USERPROFILE ".dotfiles-private\ssh"
$dst = Join-Path $env:USERPROFILE ".ssh"
New-Item -ItemType Directory -Force -Path $dst | Out-Null
if (Test-Path (Join-Path $src "*.pub")) {
    Copy-Item -Path (Join-Path $src "*.pub") -Destination $dst -Force
}
{{- end }}
