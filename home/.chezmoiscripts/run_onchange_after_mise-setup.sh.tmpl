#!/usr/bin/env bash
#
# Installs the tool versions pinned in ~/.config/mise/config.toml (after_
# prefix: runs once the config is in place). Non-fatal: individual tool
# failures are logged but don't block chezmoi apply.
#
# run_onchange_ + the config hash below means chezmoi re-runs `mise install`
# automatically whenever the pinned versions change (bump a version, commit,
# `chezmoi apply`). Mirrors run_onchange_after_mise-setup.ps1 on Windows.
#
# mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

set -uo pipefail

if ! command -v mise &>/dev/null; then
    echo "mise not found -- skipping (https://mise.jdx.dev)"
    exit 0
fi

echo "Running mise install..."
if mise install --yes 2>&1; then
    echo "mise install complete"
else
    echo "WARNING: mise install had failures (see above). Run 'mise install' manually to retry."
fi

exit 0
