<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jared.helium-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-l</string>
        <string>/Users/jaredconnor/.local/bin/helium-autosync</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/jaredconnor/.local/share/helium-sync/launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jaredconnor/.local/share/helium-sync/launchd.log</string>

    <!-- Only run when on a network (it pushes to the Forgejo data repo) -->
    <key>NetworkState</key>
    <true/>
</dict>
</plist>
