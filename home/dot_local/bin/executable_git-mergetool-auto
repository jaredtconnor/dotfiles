#!/usr/bin/env bash
# Dispatch `git mergetool` to whichever editor's terminal we're running in.
# See git-difftool-auto for the detection rationale.
# git mergetool args order: REMOTE LOCAL BASE MERGED
set -u

REMOTE="$1"
LOCAL="$2"
BASE="$3"
MERGED="$4"

if [ -n "${VSCODE_GIT_ASKPASS_NODE:-}" ] && printf '%s' "$VSCODE_GIT_ASKPASS_NODE" | grep -qi cursor; then
    exec cursor --wait --merge "$REMOTE" "$LOCAL" "$BASE" "$MERGED"
fi

case "${TERM_PROGRAM:-}" in
    vscode) exec code --wait --merge "$REMOTE" "$LOCAL" "$BASE" "$MERGED" ;;
    zed)    exec zed  --wait --merge "$REMOTE" "$LOCAL" "$BASE" "$MERGED" ;;
esac

if [ -n "${VSINSTALLDIR:-}" ]; then
    vsdm="$VSINSTALLDIR/Common7/IDE/CommonExtensions/Microsoft/TeamFoundation/Team Explorer/vsDiffMerge.exe"
    if [ -x "$vsdm" ] || [ -f "$vsdm" ]; then
        # vsDiffMerge merge order: Theirs Mine Base Merged ; //m = merge mode.
        exec "$vsdm" "$REMOTE" "$LOCAL" "$BASE" "$MERGED" //m
    fi
fi

if command -v code >/dev/null 2>&1; then
    exec code --wait --merge "$REMOTE" "$LOCAL" "$BASE" "$MERGED"
fi
echo "git-mergetool-auto: no editor detected and 'code' not found" >&2
exit 1
