#!/usr/bin/env bash
#
# happy-fleet — run the Happy Coder daemon across your homelab dev hosts so you
# can spawn Claude Code / Codex sessions in ANY project on ANY host from your
# phone (https://happy.engineering).
#
# Why a daemon, not a session-per-repo: Happy's daemon keeps a host online and
# lets the phone/web app start a session in any directory on demand. That beats
# pre-spawning `happy claude` in every project (dozens of idle processes). One
# daemon per host = every project on that host reachable from your pocket.
#
# Hosts come from ~/.config/happy-fleet/hosts (one per line, # comments ok),
# falling back to DEFAULT_HOSTS below. Only list machines that RUN CODE — not
# the pihole/NAS/gateway. Each host needs `claude` installed + logged in.
#
# Usage:
#   happy-fleet up [--hosts "h1 h2"]      # start the daemon everywhere (idempotent)
#   happy-fleet status [--hosts ...]      # daemon status per host
#   happy-fleet down [--hosts ...]        # stop the daemon everywhere
#   happy-fleet bootstrap [--hosts ...]   # install node@lts + happy on hosts that lack it
#   happy-fleet list                      # show configured hosts
#
# ssh access must match ~/.ssh/config (1Password Touch ID prompts are fine).
#
set -uo pipefail

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; BLUE='\033[0;34m'; NC='\033[0m'
info()  { printf "${GREEN}%s${NC}\n" "$*"; }
warn()  { printf "${YELLOW}%s${NC}\n" "$*"; }
fail()  { printf "${RED}%s${NC}\n" "$*" >&2; }
head_() { printf "\n${BLUE}== %s ==${NC}\n" "$*"; }

FLEET_FILE="$HOME/.config/happy-fleet/hosts"
DEFAULT_HOSTS=(apollo perseverance curiosity discovery)

# node/happy/claude live off the default non-interactive PATH, and the location
# differs per host (Linux mise shims, macOS Homebrew, custom npm prefix). Prepend
# every likely bin dir so remote AND local commands resolve them on any OS.
REMOTE_PATH='export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$HOME/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:$PATH";'

usage() { awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$0"; exit "${1:-0}"; }

load_hosts() {
    if [[ -f "$FLEET_FILE" ]]; then
        local hosts=()
        while IFS= read -r line; do
            line="${line%%#*}"; line="${line// /}"
            [[ -n "$line" ]] && hosts+=("$line")
        done < "$FLEET_FILE"
        [[ ${#hosts[@]} -gt 0 ]] && { printf '%s\n' "${hosts[@]}"; return; }
    fi
    printf '%s\n' "${DEFAULT_HOSTS[@]}"
}

# Names that identify THIS machine, lowercased: hostname variants, plus macOS
# ComputerName/LocalHostName (a Mac's `hostname` can be "Mac" while the fleet
# alias is "perseverance"), plus an optional $HAPPY_FLEET_SELF override. Lets us
# run locally instead of SSHing to ourselves when the alias differs.
is_self() {
    local want; want=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
    local names name
    names="$(hostname 2>/dev/null)"$'\n'"$(hostname -s 2>/dev/null)"
    if [[ "$(uname 2>/dev/null)" == "Darwin" ]]; then
        names+=$'\n'"$(scutil --get ComputerName 2>/dev/null)"$'\n'"$(scutil --get LocalHostName 2>/dev/null)"
    fi
    [[ -n "${HAPPY_FLEET_SELF:-}" ]] && names+=$'\n'"$HAPPY_FLEET_SELF"
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        [[ "$want" == "$(printf '%s' "$name" | tr 'A-Z' 'a-z')" ]] && return 0
    done <<< "$names"
    return 1
}

# Run a command on a host: locally if it's this box (see is_self), else over ssh.
# No BatchMode — your 1Password agent needs to prompt.
on_host() {
    local host="$1"; shift
    if is_self "$host"; then
        bash -c "$REMOTE_PATH $*"
    else
        ssh -o ConnectTimeout=10 "$host" "$REMOTE_PATH $*"
    fi
}

parse_hosts_arg() {
    HOSTS=()
    if [[ "${1:-}" == "--hosts" && -n "${2:-}" ]]; then
        read -r -a HOSTS <<< "$2"
    else
        while IFS= read -r h; do HOSTS+=("$h"); done < <(load_hosts)
    fi
}

cmd_list() { load_hosts; }

cmd_up() {
    parse_hosts_arg "$@"
    for h in "${HOSTS[@]}"; do
        head_ "$h"
        if ! on_host "$h" "command -v happy >/dev/null 2>&1"; then
            warn "happy not installed — run: happy-fleet bootstrap --hosts \"$h\""; continue
        fi
        if on_host "$h" "happy daemon start >/dev/null 2>&1; happy daemon status"; then
            info "daemon up on $h"
        else
            fail "daemon failed on $h"
        fi
    done
}

cmd_status() {
    parse_hosts_arg "$@"
    for h in "${HOSTS[@]}"; do
        head_ "$h"
        on_host "$h" "happy daemon status" || warn "unreachable / no daemon on $h"
    done
}

cmd_down() {
    parse_hosts_arg "$@"
    for h in "${HOSTS[@]}"; do
        head_ "$h"
        if on_host "$h" "happy daemon stop"; then info "stopped on $h"; else warn "not running on $h"; fi
    done
}

cmd_bootstrap() {
    parse_hosts_arg "$@"
    for h in "${HOSTS[@]}"; do
        head_ "$h"
        if on_host "$h" "happy --version >/dev/null 2>&1"; then
            info "happy already installed + resolving on $h"
        else
            info "installing happy on $h (under its mise-pinned node) ..."
            # Do NOT touch the mise global node — your chezmoi mise config owns
            # the pin (node = 24.9.0). Install happy under the ALREADY-pinned
            # node and reshim, so the shim resolves against that version and
            # survives the next `chezmoi apply`. (Installing under a different
            # node — e.g. node@lts — is exactly what broke apollo/discovery.)
            if on_host "$h" 'npm i -g happy && { command -v mise >/dev/null 2>&1 && mise reshim >/dev/null 2>&1 || true; }'; then
                if on_host "$h" "happy --version >/dev/null 2>&1"; then
                    info "installed + resolving on $h"
                else
                    warn "installed but 'happy' does not resolve on $h — node may not be pinned/installed: run there 'mise install && mise reshim'"
                fi
            else
                fail "install failed on $h (need node/npm — run 'mise install' there first)"; continue
            fi
        fi
        on_host "$h" "command -v claude >/dev/null 2>&1" \
            || warn "claude NOT found on $h — install it + run 'claude' once to log in, else Happy can't drive Claude"
    done
}

main() {
    local sub="${1:-}"; [[ -n "$sub" ]] && shift || true
    case "$sub" in
        up)        cmd_up "$@" ;;
        status)    cmd_status "$@" ;;
        down)      cmd_down "$@" ;;
        bootstrap) cmd_bootstrap "$@" ;;
        list)      cmd_list ;;
        -h|--help|help|"") usage 0 ;;
        *) fail "unknown command: $sub"; usage 1 ;;
    esac
}

main "$@"
