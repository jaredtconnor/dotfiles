#!/usr/bin/env bash
#
# Distribute the homelab admin public key to homelab hosts.
#
# The public key is fetched from 1Password if not already on disk.
# Private keys never leave 1Password — only the .pub file is used.
#
# Usage:
#   share-ssh-keys                  # distribute admin key to all hosts
#   share-ssh-keys --list           # show which hosts would be targeted
#   share-ssh-keys --fetch-only     # fetch public key from 1Password, don't distribute
#   share-ssh-keys --refresh-key    # re-fetch public key from 1Password, then distribute

set -uo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

info()  { printf "${GREEN}%s${NC}\n" "$*"; }
warn()  { printf "${YELLOW}%s${NC}\n" "$*"; }
fail()  { printf "${RED}%s${NC}\n" "$*"; }

[ -f "$HOME/.dotfiles-private/env.sh" ] && . "$HOME/.dotfiles-private/env.sh"
KEY="${DOTFILES_HOMELAB_KEY:-}"
if [[ -z "$KEY" ]]; then
    echo "share-ssh-keys: no private companion (homelab key unset); nothing to do." >&2
    exit 0
fi
PUBKEY="$HOME/.ssh/${KEY}.pub"
OP_REF="op://${DOTFILES_OP_VAULT:-Personal}/${KEY}/public key"

HOSTS_FILE="$HOME/.ssh/hosts"

# Host inventory comes from ~/.ssh/hosts (supplied by the private companion).
# No inventory is embedded in this public script.
load_hosts() {
    if [[ -f "$HOSTS_FILE" ]]; then
        local hosts=()
        while IFS= read -r line; do
            line="${line%%#*}"
            line="${line// /}"
            [[ -n "$line" ]] && hosts+=("$line")
        done < "$HOSTS_FILE"
        if [[ ${#hosts[@]} -gt 0 ]]; then
            printf '%s\n' "${hosts[@]}"
            return
        fi
    fi
    fail "No host inventory found at $HOSTS_FILE (needs the private companion)." >&2
    return 1
}

fetch_pubkey() {
    local refresh="${1:-false}"

    if [[ -f "$PUBKEY" && "$refresh" != "true" ]]; then
        info "Public key already on disk: $PUBKEY"
        info "No 1Password access needed. Use --refresh-key to fetch it again."
        return 0
    fi

    if ! command -v op &>/dev/null; then
        fail "1Password CLI (op) not found."
        fail "Install: brew install 1password-cli"
        fail "Or manually save the public key to $PUBKEY"
        return 1
    fi

    warn "Fetching public key from 1Password..."
    local tmp
    tmp="$(mktemp "${PUBKEY}.XXXXXX")"
    if op read --no-newline "$OP_REF" > "$tmp" 2>/dev/null; then
        printf '\n' >> "$tmp"
        if ! ssh-keygen -l -f "$tmp" >/dev/null 2>&1; then
            rm -f "$tmp"
            fail "1Password returned something that is not an SSH public key."
            return 1
        fi
        mv "$tmp" "$PUBKEY"
        chmod 644 "$PUBKEY"
        info "Saved to $PUBKEY"
    else
        rm -f "$tmp"
        fail "Failed to read public key from 1Password."
        fail "Make sure the item '$KEY' exists in your ${DOTFILES_OP_VAULT:-Personal} vault."
        return 1
    fi
}

if [[ "${1:-}" == "--list" ]]; then
    echo "Hosts that will receive the admin public key:"
    while IFS= read -r h; do
        echo "  $h"
    done < <(load_hosts)
    echo ""
    echo "Override by editing $HOSTS_FILE (one host per line)."
    exit 0
fi

if [[ "${1:-}" == "--fetch-only" ]]; then
    fetch_pubkey false
    exit $?
fi

REFRESH_KEY=false
if [[ "${1:-}" == "--refresh-key" ]]; then
    REFRESH_KEY=true
elif [[ -n "${1:-}" ]]; then
    fail "Unknown option: $1"
    fail "Usage: share-ssh-keys [--list|--fetch-only|--refresh-key]"
    exit 2
fi

echo ""
info "=== SSH Admin Key Distribution ==="
echo ""

fetch_pubkey "$REFRESH_KEY" || exit 1

echo ""
info "Public key:"
cat "$PUBKEY"
echo ""

info "=== Distributing to hosts ==="
echo ""

SUCCESS=()
FAILED=()
SKIPPED=()

mapfile -t TARGET_HOSTS < <(load_hosts)

for host in "${TARGET_HOSTS[@]}"; do
    printf "${YELLOW}%-20s${NC} " "$host"

    resolved=$(ssh -G "$host" 2>/dev/null | awk '/^hostname /{print $2}')
    if [[ -z "$resolved" ]]; then
        fail "not in ssh config, skipping"
        SKIPPED+=("$host")
        continue
    fi

    if ! ping -c 1 -W 2 "$resolved" > /dev/null 2>&1; then
        fail "unreachable ($resolved)"
        SKIPPED+=("$host")
        continue
    fi

    if ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" true > /dev/null 2>&1; then
        info "already authorized"
        SUCCESS+=("$host")
        continue
    fi

    if ssh-copy-id -f -i "$PUBKEY" -o ConnectTimeout=5 "$host"; then
        info "done"
        SUCCESS+=("$host")
    else
        fail "failed"
        FAILED+=("$host")
    fi
done

echo ""
info "=== Summary ==="
[[ ${#SUCCESS[@]} -gt 0 ]] && info "  Succeeded: ${SUCCESS[*]}"
[[ ${#SKIPPED[@]} -gt 0 ]] && warn "  Skipped:   ${SKIPPED[*]}"
[[ ${#FAILED[@]} -gt 0 ]]  && fail "  Failed:    ${FAILED[*]}"
echo ""
info "Test with: ssh <hostname>"
