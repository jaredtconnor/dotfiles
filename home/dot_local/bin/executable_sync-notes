#!/usr/bin/env bash
# sync-notes — bidirectional rsync between Apollo and Skylab NAS
# Runs via LaunchAgent every 5 minutes
# Chain: Apollo <-> NAS <- NFS <- Discovery <- obsidian-headless-sync -> Obsidian Cloud -> all devices

set -euo pipefail

# Private specifics (NAS host/user/paths) come from the companion env; absent on
# a public checkout, where this script exits cleanly.
[ -f "$HOME/.dotfiles-private/env.sh" ] && . "$HOME/.dotfiles-private/env.sh"
NAS_USER="${DOTFILES_NAS_USER:-}"
NAS_HOST="${DOTFILES_NOTES_NAS_HOST:-}"
NAS_PERSONAL="${DOTFILES_NOTES_NAS_PATH:-}"
NAS_WORK="${DOTFILES_NOTES_NAS_WORK:-}"
LOCAL_PERSONAL="$HOME/${DOTFILES_NOTES_LOCAL_DIR:-notes}"
LOCAL_WORK="$HOME/work-notes"
if [ -z "$NAS_HOST" ] || [ -z "$NAS_USER" ]; then
  echo "sync-notes: no private companion (NAS config unset); nothing to do." >&2
  exit 0
fi

LOG="$HOME/.local/share/sync-notes/sync.log"
mkdir -p "$(dirname "$LOG")"

log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG"
}

RSYNC_COMMON=(
  rsync -avz --checksum
  --exclude='.git'
  --exclude='.DS_Store'
  --exclude='.trash'
  --exclude='.obsidian/workspace*'  # don't sync workspace state across machines
  -e "ssh -o ConnectTimeout=5 -o BatchMode=yes"
)

log "=== sync-notes start ==="

# --- Pull first: get any changes from other devices via Obsidian Sync cloud ---
log "Pulling personal-notes from NAS..."
"${RSYNC_COMMON[@]}" \
  "${NAS_USER}@${NAS_HOST}:${NAS_PERSONAL}/" \
  "${LOCAL_PERSONAL}/" \
  && log "Pull personal-notes OK" || log "WARN: Pull personal-notes failed"

log "Pulling work-notes from NAS..."
"${RSYNC_COMMON[@]}" \
  "${NAS_USER}@${NAS_HOST}:${NAS_WORK}/" \
  "${LOCAL_WORK}/" \
  && log "Pull work-notes OK" || log "WARN: Pull work-notes failed"

# --- Push: send Apollo's changes to NAS ---
log "Pushing personal-notes to NAS..."
"${RSYNC_COMMON[@]}" --delete \
  "${LOCAL_PERSONAL}/" \
  "${NAS_USER}@${NAS_HOST}:${NAS_PERSONAL}/" \
  && log "Push personal-notes OK" || log "WARN: Push personal-notes failed"

log "Pushing work-notes to NAS..."
"${RSYNC_COMMON[@]}" --delete \
  "${LOCAL_WORK}/" \
  "${NAS_USER}@${NAS_HOST}:${NAS_WORK}/" \
  && log "Push work-notes OK" || log "WARN: Push work-notes failed"

log "=== sync-notes done ==="
